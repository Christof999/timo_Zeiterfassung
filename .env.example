# Firebase Web-App (Vite) – Werte aus der Firebase Console (Projekt: timozeiterfassung)
# Kopiere diese Datei nach .env und ersetze die Platzhalter durch deine echten Werte.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=timozeiterfassung.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=timozeiterfassung
# Exakten Bucket aus der Console übernehmen (häufig …appspot.com oder …firebasestorage.app)
VITE_FIREBASE_STORAGE_BUCKET=timozeiterfassung.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional Web Push (öffentlicher VAPID-Key)
VITE_PUSH_VAPID_PUBLIC_KEY=

# Kundenstamm aus dem Rechnungsprogramm (zweites Firebase-Projekt, nur lesend).
# Werte = VITE_FIREBASE_* des Rechnungsprogramms. Ohne diese Angaben zeigt die
# Kundenauswahl ersatzweise die eigene customers-Collection der Zeiterfassung.
VITE_INVOICE_FIREBASE_API_KEY=
VITE_INVOICE_FIREBASE_AUTH_DOMAIN=timorechnungsprgramm.firebaseapp.com
VITE_INVOICE_FIREBASE_PROJECT_ID=timorechnungsprgramm
VITE_INVOICE_FIREBASE_STORAGE_BUCKET=
VITE_INVOICE_FIREBASE_MESSAGING_SENDER_ID=
VITE_INVOICE_FIREBASE_APP_ID=

# Server (z. B. Vercel) – Firebase Admin + Push; siehe FIREBASE.md
FIREBASE_PROJECT_ID=timozeiterfassung
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@timozeiterfassung.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
PUSH_VAPID_PRIVATE_KEY=dein-vapid-private-key
PUSH_VAPID_SUBJECT=mailto:admin@deine-domain.de
# Optional: alternativer Service-Token statt Firebase ID Token
PUSH_API_TOKEN=optional-service-token
# Server-seitig ebenfalls nötig (Push-Versand): öffentlicher VAPID-Key
PUSH_VAPID_PUBLIC_KEY=dein-vapid-public-key

# Automatisches Ausstempeln um 18:00 (Vercel Cron -> /api/cron/auto-clockout).
# Vercel sendet bei gesetztem CRON_SECRET automatisch den Header
# "Authorization: Bearer <CRON_SECRET>" an Cron-Aufrufe. MUSS gesetzt sein,
# sonst lehnt die Route den Aufruf ab (401). Beliebiger langer Zufallswert.
CRON_SECRET=langer-zufallswert

# E-Mail-Versand des Zeiterfassungsberichts über den Email-Proxy
# (nur Server – niemals VITE_ prefix, sonst landet der Key im Browser-Bundle!)
# Wird von /api/send-report genutzt. Der Key gehört zum Proxy-Client
# "timo-zeiterfassung"; ein neuer Key lässt sich am Proxy per Rotation erzeugen.
EMAILPROXY_URL=https://dein-emailproxy.vercel.app
EMAILPROXY_KEY=ep_...

# Mörgel KI-Assistent (nur Server – niemals VITE_ prefix!)
# Gemini API-Key aus Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Optional: Modell überschreiben (Standard gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash
