rules_version = '2';
// Firebase Storage: Uploads der Zeiterfassung. Lesen nur für angemeldete Nutzer
// (öffentliches Lesen geschlossen). Download-URLs mit Token funktionieren weiter.
service firebase.storage {
  match /b/{bucket}/o {
    match /uploads/{projectId}/{employeeId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
